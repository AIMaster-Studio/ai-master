# AI Master 环境变量配置模板
# 复制此文件为 .env 并填入实际值，.env 已被 .gitignore 忽略，不会提交到仓库。
# 生产环境（如 Render）请在平台面板中配置环境变量，不要使用 .env 文件。

# DeepSeek API Key（必填，用于 AI 讲解复评）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 服务端口（可选，默认 8787）
PORT=

# Turso 远程数据库（用于公网部署的数据持久化）
# 不设置则使用本地 SQLite（桌面端/本地开发/单元测试）
# 注册地址：https://turso.tech  免费层 500MB
TURSO_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# RAG 嵌入模型（可选）
# ---------------------------------------------------------------------------
# 不配置时使用「本机哈希嵌入」：零依赖、不联网，但**只反映词面重合、不是语义检索**，
# 同义改写与跨语言提问会漏召回。检索结果里会如实标注这一点。
# 配置后走 OpenAI 兼容的 /embeddings 接口，得到真正的语义向量。
# ⚠️ 换嵌入模型后必须重建索引：不同嵌入模型的向量空间不可混用，服务端会直接拒绝。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Agent 能力（可选）
# ---------------------------------------------------------------------------
# 「深度研究」这类 agent 循环能力的单次模型调用超时（毫秒，默认 60000）
AGENT_TIMEOUT_MS=

# AI 复评超时（毫秒，默认 60000）
AI_REVIEW_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 公网暴露时的管理接口令牌（重要）
# ---------------------------------------------------------------------------
# 服务默认只绑定 127.0.0.1。一旦通过 PORT 或 AIMASTER_ALLOWED_HOSTS 对外暴露，
# 回环对端不再有鉴别力，以下写操作将**一律要求**本令牌，否则 403：
#   写模型配置、建/删知识库、入库文档、重建索引、清空记忆、安装/卸载技能。
# 未配置该变量时，暴露模式下这些接口全部不可写（fail-closed）。
AIMASTER_CONFIG_TOKEN=

# 显式 Host 允许名单（逗号分隔，如 xxx.trycloudflare.com）
AIMASTER_ALLOWED_HOSTS=
